NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production

# Domínios públicos. Crie registros DNS A/AAAA antes do primeiro deploy.
APP_DOMAIN=ofertas.example.com
API_DOMAIN=api.ofertas.example.com
GRAFANA_DOMAIN=grafana.ofertas.example.com
TLS_EMAIL=admin@example.com

# Imagens imutáveis publicadas pelo workflow Release Images.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=ruanmarcos38
RELEASE_TAG=latest
API_IMAGE=promotion-radar-api
WEB_IMAGE=promotion-radar-web

# Aplicação
API_HOST=0.0.0.0
API_PORT=3333
PUBLIC_API_URL=https://api.ofertas.example.com
FRONTEND_ORIGINS=https://ofertas.example.com
JWT_EXPIRES_IN=15m
JWT_ISSUER=promotion-radar-api
JWT_AUDIENCE=promotion-radar-web
BOOTSTRAP_ADMIN_ENABLED=true
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ALLOW_INSECURE_OUTBOUND_HTTP=false
ALLOW_PRIVATE_OUTBOUND_HOSTS=
OUTBOUND_HTTP_TIMEOUT_MS=10000

POSTGRES_USER=promo
POSTGRES_DB=promo_db
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
DATABASE_MIGRATIONS_MANAGED_EXTERNALLY=true

DEFAULT_MARKETPLACE=mercadolivre
DEFAULT_KEYWORDS=iphone,smart tv,notebook,air fryer,monitor gamer,fone bluetooth
MIN_DISCOUNT_PERCENT=10
MIN_OPPORTUNITY_SCORE=55
REQUIRE_VERIFIED_AFFILIATE_LINKS=true
COLLECT_INTERVAL_SECONDS=60
MAX_RESULTS_PER_SOURCE=30
MERCADO_LIVRE_SITE_ID=MLB
AFFILIATE_LINK_RESOLVER_URL=

AMAZON_ENABLED=false
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br
AMAZON_SEARCH_INDEX=All
AMAZON_CREATORS_API_BASE_URL=https://creatorsapi.amazon

SHOPEE_ENABLED=false
SHOPEE_APP_ID=
SHOPEE_AFFILIATE_GRAPHQL_URL=https://open-api.affiliate.shopee.com.br/graphql

DISPATCH_ATTEMPTS=5
DISPATCH_BACKOFF_MS=10000
DISPATCH_CONCURRENCY=8
DISPATCH_COMPLETED_RETENTION_SECONDS=604800
DISPATCH_FAILED_RETENTION_SECONDS=1209600
DISPATCH_RETENTION_COUNT=10000

# O Alertmanager é o canal de plantão padrão. Habilite os alertas internos da aplicação
# somente quando Telegram, webhook e SMTP também estiverem completamente configurados.
OPERATIONAL_ALERTS_ENABLED=false
OPERATIONAL_ALERT_CHANNELS=telegram,email,webhook
OPERATIONAL_ALERT_DLQ_THRESHOLD=5
OPERATIONAL_ALERT_CHECK_INTERVAL_SECONDS=60
OPERATIONAL_ALERT_COOLDOWN_SECONDS=900
OPERATIONAL_ALERT_RECOVERY_ENABLED=true
OPERATIONAL_ALERT_ATTEMPTS=5
OPERATIONAL_ALERT_BACKOFF_MS=30000
OPERATIONAL_ALERT_CONCURRENCY=3
OPERATIONAL_ALERT_DASHBOARD_URL=https://grafana.ofertas.example.com
OPERATIONAL_ALERT_TELEGRAM_CHAT_ID=
OPERATIONAL_ALERT_EMAIL_FROM=alerts@example.com
OPERATIONAL_ALERT_EMAIL_TO=oncall@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=

METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_COLLECT_DEFAULTS=true
WORKER_METRICS_HOST=0.0.0.0
WORKER_METRICS_PORT=9464

OTEL_ENABLED=false
OTEL_SERVICE_NAME=promotion-radar
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SAMPLING_RATIO=0.10

SLO_WINDOW_DAYS=30
SLO_MINIMUM_SAMPLES=20
SLO_API_AVAILABILITY_TARGET=0.999
SLO_DISPATCH_SUCCESS_TARGET=0.98
SLO_OPERATIONAL_ALERT_SUCCESS_TARGET=0.99
SLO_QUEUE_LATENCY_P95_SECONDS=30

PROMETHEUS_IMAGE=prom/prometheus:v3.13.1
PROMETHEUS_RETENTION=30d
ALERTMANAGER_IMAGE=prom/alertmanager:v0.33.1
GRAFANA_IMAGE=grafana/grafana:13.1.0
CADDY_IMAGE=caddy:2-alpine

# Alertmanager — os tokens, senhas e URLs de webhook ficam em deploy/secrets/.
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
ALERTMANAGER_SMTP_FROM=alerts@example.com
ALERTMANAGER_SMTP_USERNAME=alerts@example.com
ALERTMANAGER_EMAIL_TO=oncall@example.com
ALERTMANAGER_TELEGRAM_CHAT_ID=1

# Grafana / OIDC genérico (Google Workspace, Auth0, Keycloak, Azure AD etc.).
GRAFANA_ADMIN_USER=admin
GRAFANA_OAUTH_ENABLED=false
GRAFANA_OAUTH_NAME=SSO
GRAFANA_OAUTH_CLIENT_ID=
GRAFANA_OAUTH_SCOPES=openid profile email groups
GRAFANA_OAUTH_AUTH_URL=
GRAFANA_OAUTH_TOKEN_URL=
GRAFANA_OAUTH_API_URL=
GRAFANA_OAUTH_ROLE_ATTRIBUTE_PATH=Viewer
GRAFANA_OAUTH_ALLOWED_DOMAINS=
GRAFANA_DISABLE_LOGIN_FORM=false

# Backups locais. Para produção crítica, sincronize BACKUP_DIR com storage externo.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_RECIPIENT=

# Healthcheck e rollback
DEPLOY_HEALTHCHECK_ATTEMPTS=30
DEPLOY_HEALTHCHECK_INTERVAL_SECONDS=5
