# Cole estas variáveis nos serviços API e Worker do projeto promotion-radar.
# Substitua todos os valores CHANGE_ME diretamente no EasyPanel.

NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=homologation
API_PORT=3333
PUBLIC_API_URL=https://api-ofertas.r2rmarketingdigital.com.br
FRONTEND_ORIGINS=https://ofertas.r2rmarketingdigital.com.br

# Copie a URL interna exibida pelo serviço PostgreSQL do EasyPanel.
DATABASE_URL=postgresql://promo:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/promo_db?schema=public

# Copie a URL interna exibida pelo serviço Redis do EasyPanel.
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_EXPIRES_IN=15m
JWT_ISSUER=promotion-radar-api
JWT_AUDIENCE=promotion-radar-web
CHANNEL_CONFIG_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_HEX

BOOTSTRAP_ADMIN_ENABLED=true
ADMIN_NAME=Administrador
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

OUTBOUND_HTTP_TIMEOUT_MS=10000
ALLOW_INSECURE_OUTBOUND_HTTP=false
ALLOW_PRIVATE_OUTBOUND_HOSTS=

DEFAULT_MARKETPLACE=mercadolivre
DEFAULT_KEYWORDS=iphone,smart tv,notebook,air fryer,monitor gamer,fone bluetooth
MIN_DISCOUNT_PERCENT=10
MIN_OPPORTUNITY_SCORE=55
COLLECT_INTERVAL_SECONDS=60
MAX_RESULTS_PER_SOURCE=30
MERCADO_LIVRE_SITE_ID=MLB
MERCADO_LIVRE_AFFILIATE_TAG=

DISPATCH_ATTEMPTS=5
DISPATCH_BACKOFF_MS=10000
DISPATCH_CONCURRENCY=8
DISPATCH_COMPLETED_RETENTION_SECONDS=604800
DISPATCH_FAILED_RETENTION_SECONDS=1209600
DISPATCH_RETENTION_COUNT=10000

OPERATIONAL_ALERTS_ENABLED=false
OPERATIONAL_ALERT_CHANNELS=telegram,email,webhook
OPERATIONAL_ALERT_DLQ_THRESHOLD=5
OPERATIONAL_ALERT_CHECK_INTERVAL_SECONDS=60
OPERATIONAL_ALERT_COOLDOWN_SECONDS=900
OPERATIONAL_ALERT_RECOVERY_ENABLED=true
OPERATIONAL_ALERT_ATTEMPTS=5
OPERATIONAL_ALERT_BACKOFF_MS=30000
OPERATIONAL_ALERT_CONCURRENCY=3
OPERATIONAL_ALERT_DASHBOARD_URL=https://grafana-ofertas.r2rmarketingdigital.com.br
OPERATIONAL_ALERT_TELEGRAM_BOT_TOKEN=
OPERATIONAL_ALERT_TELEGRAM_CHAT_ID=
OPERATIONAL_ALERT_WEBHOOK_URL=
OPERATIONAL_ALERT_WEBHOOK_SECRET=CHANGE_ME_RANDOM_64_CHARS
OPERATIONAL_ALERT_EMAIL_FROM=
OPERATIONAL_ALERT_EMAIL_TO=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_BEARER_TOKEN=CHANGE_ME_RANDOM_64_CHARS
METRICS_COLLECT_DEFAULTS=true
WORKER_METRICS_HOST=0.0.0.0
WORKER_METRICS_PORT=9464

OTEL_ENABLED=false
OTEL_SERVICE_NAME=promotion-radar
OTEL_SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SAMPLING_RATIO=0.10

SLO_WINDOW_DAYS=30
SLO_MINIMUM_SAMPLES=20
SLO_API_AVAILABILITY_TARGET=0.999
SLO_DISPATCH_SUCCESS_TARGET=0.98
SLO_OPERATIONAL_ALERT_SUCCESS_TARGET=0.99
SLO_QUEUE_LATENCY_P95_SECONDS=30

AMAZON_ENABLED=false
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_HOST=webservices.amazon.com.br
AMAZON_REGION=us-east-1

SHOPEE_ENABLED=false
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_AFFILIATE_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_DEFAULT_TO=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
