{
  "uid": "promotion-radar-overview",
  "title": "Radar de Ofertas — Visão Operacional",
  "tags": ["promotion-radar", "operations"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Disponibilidade API — 1h",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "promotion-radar-prometheus"},
      "targets": [{"refId": "A", "expr": "promotion_radar:sli_api_availability:ratio_rate1h", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 0.995}, {"color": "green", "value": 0.999}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Sucesso da distribuição",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "promotion-radar-prometheus"},
      "targets": [{"refId": "A", "expr": "avg(promotion_radar:sli_dispatch_success:ratio_rate15m)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.98}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Saúde dos alertas",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "promotion-radar-prometheus"},
      "targets": [{"refId": "A", "expr": "avg(promotion_radar:sli_operational_alert_success:ratio_rate15m)", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.99}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Itens na DLQ",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "promotion-radar-prometheus"},
      "targets": [{"refId": "A", "expr": "promotion_radar_dispatch_dlq_items", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Profundidade das filas",
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "promotion-radar-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (queue, state) (promotion_radar_queue_depth)", "legendFormat": "{{queue}} · {{state}}"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência p95 das filas",
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "promotion-radar-prometheus"},
      "targets": [{"refId": "A", "expr": "promotion_radar:sli_queue_waiting:p95_seconds_rate10m", "legendFormat": "{{queue}}"}],
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 20}, {"color": "red", "value": 30}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Alertas ativos",
      "gridPos": {"x": 0, "y": 13, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "promotion-radar-prometheus"},
      "targets": [{"refId": "A", "expr": "ALERTS{service=\"promotion-radar\",alertstate=\"firing\"}", "format": "table", "instant": true}],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true}
    }
  ]
}
