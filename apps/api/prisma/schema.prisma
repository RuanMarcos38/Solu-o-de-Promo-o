generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Marketplace {
  MERCADO_LIVRE
  AMAZON
  SHOPEE
  MAGALU
  ALIEXPRESS
  OTHER
}

enum DispatchStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketplaceSource {
  id          String      @id @default(cuid())
  name        String
  marketplace Marketplace
  isActive    Boolean     @default(true)
  keywords    String[]
  config      Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([marketplace, isActive])
}

model Offer {
  id              String       @id @default(cuid())
  externalId      String
  marketplace     Marketplace
  title           String
  normalizedTitle String
  category        String?
  currentPrice    Decimal      @db.Decimal(12, 2)
  originalPrice   Decimal?     @db.Decimal(12, 2)
  discountPercent Decimal?     @db.Decimal(5, 2)
  imageUrl        String?
  productUrl      String
  affiliateUrl    String?
  sellerName      String?
  rating          Decimal?     @db.Decimal(3, 2)
  freeShipping    Boolean      @default(false)
  score           Int          @default(0)
  isActive        Boolean      @default(true)
  firstSeenAt     DateTime     @default(now())
  lastSeenAt      DateTime     @updatedAt
  priceHistory    PriceHistory[]
  dispatchLogs    DispatchLog[]

  @@unique([marketplace, externalId])
  @@index([marketplace, score])
  @@index([normalizedTitle])
  @@index([category])
  @@index([score])
}

model PriceHistory {
  id         String   @id @default(cuid())
  offerId    String
  price      Decimal  @db.Decimal(12, 2)
  capturedAt DateTime @default(now())
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, capturedAt])
}

model AlertRule {
  id                 String   @id @default(cuid())
  name               String
  keywords           String[]
  marketplaces       String[]
  minDiscountPercent Int      @default(10)
  maxPrice           Decimal? @db.Decimal(12, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DispatchChannel {
  id        String   @id @default(cuid())
  name      String
  type      String
  config    Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DispatchLog {
  id         String         @id @default(cuid())
  offerId    String
  channel    String
  status     DispatchStatus @default(PENDING)
  payload    Json?
  error      String?
  createdAt  DateTime       @default(now())
  offer      Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
}
