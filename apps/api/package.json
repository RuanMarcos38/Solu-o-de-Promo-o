{
  "name": "@promo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/start.js",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/start.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "node scripts/prisma-generate.cjs",
    "prisma:migrate": "node scripts/prisma-migrate.cjs",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --import ./test/setup.ts --test --test-concurrency=1 test/scoring.test.ts test/secrets.test.ts test/http.test.ts test/dispatch.test.ts",
    "test:integration": "node --import tsx --import ./test/setup.ts --test --test-concurrency=1 test/integration.test.ts",
    "test:coverage": "node --import tsx --import ./test/setup.ts --experimental-test-coverage --test --test-concurrency=1 test/scoring.test.ts test/secrets.test.ts test/http.test.ts test/dispatch.test.ts test/integration.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@fastify/rate-limit": "10.2.2",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "bullmq": "5.80.2",
    "dotenv": "16.4.7",
    "fastify": "5.8.5",
    "ioredis": "5.8.2",
    "jsonwebtoken": "9.0.2",
    "socket.io": "4.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.2",
    "prisma": "6.19.3",
    "tsx": "4.23.1",
    "typescript": "5.7.2"
  }
}
