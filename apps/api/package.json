{
  "name": "@promo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/start.js",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/start.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "node scripts/prisma-generate.cjs",
    "prisma:migrate": "prisma migrate dev",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@prisma/client": "latest",
    "bullmq": "latest",
    "dotenv": "latest",
    "fastify": "latest",
    "ioredis": "latest",
    "socket.io": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "prisma": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
