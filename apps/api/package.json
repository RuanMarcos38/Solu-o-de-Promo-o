{
  "name": "@promo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/start.js",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/start.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "node scripts/prisma-generate.cjs",
    "prisma:migrate": "node scripts/prisma-migrate.cjs",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.0.1",
    "@prisma/client": "6.14.0",
    "bcryptjs": "3.0.2",
    "bullmq": "5.58.0",
    "dotenv": "16.4.7",
    "fastify": "5.4.0",
    "ioredis": "5.7.0",
    "jsonwebtoken": "9.0.2",
    "socket.io": "4.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.2",
    "prisma": "6.14.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
