{
  "name": "solucao-de-promocao",
  "version": "0.1.0",
  "private": true,
  "description": "Radar de ofertas em tempo real com marketplace adapters, score de promoção e distribuição de oportunidades.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api & npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:worker": "npm run dev:worker -w apps/api",
    "build": "npm run db:generate && npm run build -w apps/api && npm run build -w apps/web",
    "start": "npm run start -w apps/api",
    "start:worker": "npm run start:worker -w apps/api",
    "db:generate": "npm run prisma:generate -w apps/api",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "lint": "npm run lint -w apps/api && npm run lint -w apps/web",
    "test": "npm run test -w apps/api",
    "test:unit": "npm run test:unit -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "test:coverage": "npm run test:coverage -w apps/api",
    "observability:validate": "node scripts/validate-observability.mjs",
    "observability:up": "docker compose --profile observability up -d",
    "observability:down": "docker compose --profile observability down",
    "deploy:validate": "node scripts/validate-deploy.mjs && node scripts/validate-go-live.mjs",
    "deploy:prepare": "bash scripts/prepare-production.sh",
    "deploy:render-alertmanager": "bash scripts/render-alertmanager.sh",
    "deploy:release": "bash scripts/deploy-production.sh",
    "deploy:rollback": "bash scripts/rollback-production.sh",
    "go-live:preflight": "bash scripts/go-live-preflight.sh deploy/homologation.env",
    "go-live:publish": "bash scripts/publish-homologation-release.sh deploy/homologation.env",
    "go-live:smoke": "bash scripts/go-live-smoke.sh deploy/homologation.env",
    "go-live:drill": "bash scripts/homologation-dr-drill.sh deploy/homologation.env",
    "backup:production": "bash scripts/backup-production.sh",
    "restore:production": "bash scripts/restore-production.sh",
    "verify": "npm run db:generate && npm run lint && npm run test:unit && npm run observability:validate && npm run deploy:validate && npm run build",
    "docker:build": "docker compose build api worker web"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "ofertas",
    "promocoes",
    "marketplaces",
    "afiliados",
    "real-time"
  ],
  "license": "MIT"
}
