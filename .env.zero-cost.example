# Zenite Ofertas — integrações oficiais / sem API terceirizada paga
# Copie somente as chaves necessárias para o ambiente do EasyPanel.

REQUIRE_VERIFIED_AFFILIATE_LINKS=true

# Mercado Livre
MERCADO_LIVRE_SITE_ID=MLB
MERCADO_LIVRE_ACCESS_TOKEN=
# Use somente um resolvedor autorizado pelo programa de afiliados.
AFFILIATE_LINK_RESOLVER_URL=
AFFILIATE_LINK_RESOLVER_TOKEN=

# Amazon Associates / Creators API
AMAZON_ENABLED=true
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.1
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com.br
AMAZON_SEARCH_INDEX=All
AMAZON_CREATORS_API_BASE_URL=https://creatorsapi.amazon

# Shopee Affiliate Open API
SHOPEE_ENABLED=true
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_AFFILIATE_GRAPHQL_URL=https://open-api.affiliate.shopee.com.br/graphql

# Mantenha vazio para NÃO usar fallback terceirizado potencialmente pago.
APIFY_TOKEN=

# Canais de distribuição (preencher conforme sua infraestrutura)
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_DEFAULT_TO=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
