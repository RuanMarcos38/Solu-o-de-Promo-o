FROM grafana/grafana:13.1.0

COPY --chown=grafana:grafana ops/grafana/provisioning /etc/grafana/provisioning
COPY --chown=grafana:grafana deploy/easypanel/grafana-dashboard-provider.yml /etc/grafana/provisioning/dashboards/promotion-radar.yml
COPY --chown=grafana:grafana ops/grafana/dashboards /etc/grafana/dashboards

EXPOSE 3000
