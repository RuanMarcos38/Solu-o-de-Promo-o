NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3333
WEB_PORT=5173
PUBLIC_API_URL=http://localhost:3333
FRONTEND_ORIGINS=http://localhost:5173

POSTGRES_USER=promo
POSTGRES_PASSWORD=
POSTGRES_DB=promo_db
POSTGRES_BIND_ADDRESS=127.0.0.1
DATABASE_URL=postgresql://promo:promo-local-db@localhost:5432/promo_db?schema=public
DATABASE_MIGRATIONS_MANAGED_EXTERNALLY=false

REDIS_PASSWORD=
REDIS_BIND_ADDRESS=127.0.0.1
